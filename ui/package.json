    "@vitejs/plugin-vue": "^2.2.2",
    "@vue/test-utils": "^2.0.0-rc.18",
    "cypress": "^9.5.0",
    "jsdom": "^19.0.0",
    "sass": "^1.49.10",
    "start-server-and-test": "^1.14.0",
    "vite": "^2.8.4",
    "vitest": "^0.5.0"
  }
